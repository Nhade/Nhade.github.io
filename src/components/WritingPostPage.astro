---
import PostLayout from '../layouts/PostLayout.astro';
import PostTypeBadge from './PostTypeBadge.astro';
import ProjectContext from './ProjectContext.astro';
import { render } from 'astro:content';

interface Props {
	post: any;
	allPosts: any[];
}

const { post, allPosts } = Astro.props;
const currentIndex = allPosts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
const { Content, headings } = await render(post);

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 220));
const author = post.data.author ?? 'Ray';
const tags = post.data.tags ?? [];
const postType = post.data.postType ?? 'essay';

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});

const metadataItems = [
	{ label: 'By', value: author },
	{ label: 'Published', value: formatDate(post.data.pubDate) },
	{ label: 'Reading time', value: `${readingTimeMinutes} min read` },
];

const relatedPosts = allPosts
	.filter((entry) => entry.id !== post.id)
	.filter((entry) => {
		if (post.data.project && entry.data.project === post.data.project) return true;
		const otherTags = entry.data.tags ?? [];
		return tags.some((tag) => otherTags.includes(tag));
	})
	.slice(0, 3);
---

<PostLayout
	title={`${post.data.title} | Ray's Lab`}
	description={post.data.description}
	image={post.data.heroImage}
	headings={headings}
>
	<header slot="header" class="mx-auto mb-8 max-w-3xl space-y-6 sm:mb-10">
		<div class="space-y-3">
			<a href="/writing" class="eyebrow text-xs font-medium editorial-link no-underline">Back to writing</a>
			<h1 class="font-display text-4xl font-semibold leading-[1.04] tracking-tight sm:text-5xl lg:text-6xl">
				{post.data.title}
			</h1>
			<p class="max-w-2xl text-[1.05rem] leading-8 text-base-content/76 sm:text-[1.1rem]">
				{post.data.description}
			</p>
		</div>

		<div class="editorial-meta-grid rounded-box border border-base-content/8 bg-base-200/70 p-4 sm:p-5">
			{metadataItems.map((item) => (
				<div class="space-y-1">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">{item.label}</p>
					<p class="text-sm leading-6 text-base-content/88">{item.value}</p>
				</div>
			))}
			<div class="space-y-1">
				<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Type</p>
				<PostTypeBadge type={postType} />
			</div>
			{tags.length > 0 && (
				<div class="space-y-2 sm:col-span-2 lg:col-span-1">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Tags</p>
					<div class="flex flex-wrap gap-2">
						{tags.map((tag) => (
							<a href={`/tags/${encodeURIComponent(tag)}`} class="tag-badge">
								{tag}
							</a>
						))}
					</div>
				</div>
			)}
		</div>

		{post.data.project && (
			<ProjectContext projectSlug={post.data.project} />
		)}

		{post.data.summary && (
			<div class="rounded-box border border-base-content/8 bg-base-200/50 px-5 py-4">
				<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Key takeaway</p>
				<p class="mt-2 text-sm leading-7 text-base-content/82">{post.data.summary}</p>
			</div>
		)}
	</header>

	<Content />

	<div slot="footer" class="mx-auto max-w-3xl">
		{relatedPosts.length > 0 && (
			<section class="mt-10 space-y-4">
				<h2 class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Related writing</h2>
				<div class="grid gap-3">
					{relatedPosts.map((related) => (
						<a href={`/writing/${related.id}`} class="editorial-card rounded-box p-4 transition-colors">
							<p class="text-sm font-semibold">{related.data.title}</p>
							<p class="mt-1 text-xs text-muted">{related.data.description}</p>
						</a>
					))}
				</div>
			</section>
		)}

		<nav class="mt-8 grid gap-4 sm:mt-10 md:grid-cols-2" aria-label="Post navigation">
			{newerPost ? (
				<a href={`/writing/${newerPost.id}`} class="editorial-card rounded-box p-5">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Newer post</p>
					<p class="mt-3 text-lg font-semibold leading-snug">{newerPost.data.title}</p>
				</a>
			) : (
				<div aria-hidden="true"></div>
			)}
			{olderPost ? (
				<a href={`/writing/${olderPost.id}`} class="editorial-card rounded-box p-5 md:text-right">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Older post</p>
					<p class="mt-3 text-lg font-semibold leading-snug">{olderPost.data.title}</p>
				</a>
			) : (
				<div aria-hidden="true"></div>
			)}
		</nav>
	</div>
</PostLayout>
