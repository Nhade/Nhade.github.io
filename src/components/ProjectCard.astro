---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	variant?: 'compact' | 'full';
}

const { project, variant = 'compact' } = Astro.props;
const { title, slug, status, description, longDescription, techStack, repoUrl, demoUrl, milestones, gallery } = project.data;

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
	});
---

<div id={slug} class="editorial-card rounded-box p-6 sm:p-7">
	<div class="flex items-start justify-between gap-4">
		<div class="space-y-1">
			<h3 class="text-xl font-semibold">{title}</h3>
			<p class="text-sm leading-7 text-base-content/72">{variant === 'full' && longDescription ? longDescription : description}</p>
		</div>
		<StatusBadge status={status} />
	</div>

	<div class="mt-4 flex flex-wrap gap-1.5">
		{techStack.map((tech) => (
			<span class="inline-flex items-center rounded-full border border-base-content/12 bg-base-300/40 px-2.5 py-0.5 text-[0.7rem] font-medium text-base-content/78">
				{tech}
			</span>
		))}
	</div>

	{variant === 'full' && milestones && milestones.length > 0 && (
		<div class="mt-6 space-y-3 border-l-2 border-base-content/10 pl-4">
			<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Milestones</p>
			{milestones.sort((a, b) => b.date.valueOf() - a.date.valueOf()).map((m) => (
				<div class="flex items-baseline gap-3">
					<time class="shrink-0 text-xs text-muted">{formatDate(m.date)}</time>
					<p class="text-sm text-base-content/82">{m.label}</p>
				</div>
			))}
		</div>
	)}

	{variant === 'full' && gallery && gallery.length > 0 && (
		<div class="mt-6">
			<p class="mb-3 text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Gallery</p>
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
				{gallery.slice(0, 6).map((item) => (
					item.type === 'video' ? (
						<div class="aspect-video overflow-hidden rounded-lg border border-base-content/8 bg-base-300/40">
							<iframe
								src={item.src.replace('/view', '/preview')}
								title={item.alt}
								class="h-full w-full"
								allow="autoplay"
								loading="lazy"
							></iframe>
						</div>
					) : (
						<img
							src={item.src}
							alt={item.alt}
							class="aspect-video rounded-lg border border-base-content/8 object-cover"
							loading="lazy"
						/>
					)
				))}
			</div>
		</div>
	)}

	<div class="mt-5 flex flex-wrap gap-2">
		{repoUrl && (
			<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
				Repo
			</a>
		)}
		{demoUrl && (
			<a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
				Demo
			</a>
		)}
	</div>
</div>
