---
interface Props {
  type?: 'info' | 'warning' | 'error' | 'success';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const defaultTitle = {
  info: 'Note',
  warning: 'Warning',
  error: 'Error',
  success: 'Success',
}[type];

const icons = {
  info: `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.5"/><path d="M8 7.2v3.6"/><circle cx="8" cy="5.2" r="0.4" fill="currentColor" stroke="none"/></svg>`,
  warning: `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.8 1.5 13.2h13L8 1.8z"/><path d="M8 6.4v3.4"/><circle cx="8" cy="11.4" r="0.4" fill="currentColor" stroke="none"/></svg>`,
  error: `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.5"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5"/></svg>`,
  success: `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.5"/><path d="M5 8.2l2 2 4-4.2"/></svg>`,
};
---

<aside class:list={['editorial-callout', `editorial-callout--${type}`, 'not-prose my-7']} role="note">
  <span class="editorial-callout__icon" aria-hidden="true" set:html={icons[type]} />
  <div class="editorial-callout__body">
    <h4 class="editorial-callout__title">{title ?? defaultTitle}</h4>
    <div class="editorial-callout__content">
      <slot />
    </div>
  </div>
</aside>

<style>
  .editorial-callout {
    --callout-accent: var(--color-primary);
    --callout-tint: color-mix(in oklch, var(--color-primary) 10%, transparent);

    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    align-items: start;
    position: relative;
    overflow: hidden;
    padding: 0.95rem 1.1rem 1rem 1.2rem;
    border-radius: 0.85rem;
    border: 1px solid color-mix(in oklch, var(--color-base-content) 10%, transparent);
    background:
      linear-gradient(135deg, var(--callout-tint), transparent 60%),
      color-mix(in oklch, var(--color-base-200) 94%, var(--color-base-100));
    box-shadow:
      0 10px 24px color-mix(in oklch, black 14%, transparent),
      inset 0 1px 0 color-mix(in oklch, white 4%, transparent);
  }

  .editorial-callout::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--callout-accent);
    opacity: 0.9;
  }

  .editorial-callout--info {
    --callout-accent: var(--color-primary);
    --callout-tint: color-mix(in oklch, var(--color-primary) 10%, transparent);
  }
  .editorial-callout--warning {
    --callout-accent: var(--color-warning);
    --callout-tint: color-mix(in oklch, var(--color-warning) 10%, transparent);
  }
  .editorial-callout--error {
    --callout-accent: var(--color-error);
    --callout-tint: color-mix(in oklch, var(--color-error) 10%, transparent);
  }
  .editorial-callout--success {
    --callout-accent: var(--color-success);
    --callout-tint: color-mix(in oklch, var(--color-success) 9%, transparent);
  }

  .editorial-callout__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    margin-top: 0.34rem;
    color: var(--callout-accent);
    flex-shrink: 0;
  }

  .editorial-callout__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .editorial-callout__title {
    font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: color-mix(in oklch, var(--callout-accent) 75%, white 25%);
    margin: 0 0 0.35rem 0;
  }

  .editorial-callout__content {
    color: color-mix(in oklch, var(--color-base-content) 96%, white 4%);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .editorial-callout__content :global(p) {
    margin: 0;
  }

  .editorial-callout__content :global(p + p) {
    margin-top: 0.55em;
  }

  .editorial-callout__content :global(strong) {
    color: var(--color-base-content);
    font-weight: 600;
  }

  .editorial-callout__content :global(code) {
    background-color: var(--color-base-300);
    border: 1px solid color-mix(in oklch, var(--color-base-content) 10%, transparent);
    border-radius: 0.4rem;
    padding: 0.16em 0.42em;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.86em;
    color: color-mix(in oklch, var(--color-base-content) 96%, white 4%);
  }

  .editorial-callout__content :global(a) {
    color: color-mix(in oklch, var(--callout-accent) 88%, white 12%);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .editorial-callout__content :global(a:hover) {
    color: color-mix(in oklch, var(--callout-accent) 95%, white 5%);
  }
</style>
