---
interface Props {
	images: Array<{ src: string; alt: string }>;
	columns?: 2 | 3;
}

const { images, columns = 2 } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`grid gap-3 ${columns === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
	{images.map((image, i) => (
		<button
			type="button"
			class="group cursor-pointer overflow-hidden rounded-lg border border-base-content/8 transition-all hover:border-primary/28 hover:shadow-lg"
			data-gallery={galleryId}
			data-index={i}
		>
			<img
				src={image.src}
				alt={image.alt}
				class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
				loading="lazy"
			/>
		</button>
	))}
</div>

<dialog id={galleryId} class="modal">
	<div class="modal-box max-w-4xl bg-base-200 p-2">
		<img id={`${galleryId}-img`} src="" alt="" class="w-full rounded-lg" />
		<p id={`${galleryId}-alt`} class="mt-2 text-center text-sm text-muted"></p>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>

<script is:inline define:vars={{ galleryId, images }}>
	document.querySelectorAll(`[data-gallery="${galleryId}"]`).forEach((btn) => {
		btn.addEventListener('click', () => {
			const index = parseInt(btn.getAttribute('data-index'));
			const dialog = document.getElementById(galleryId);
			const img = document.getElementById(`${galleryId}-img`);
			const alt = document.getElementById(`${galleryId}-alt`);
			if (dialog && img && images[index]) {
				img.src = images[index].src;
				img.alt = images[index].alt;
				alt.textContent = images[index].alt;
				dialog.showModal();
			}
		});
	});
</script>
