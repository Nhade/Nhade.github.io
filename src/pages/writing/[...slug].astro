---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import WritingPostPage from '../../components/WritingPostPage.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const collectionFilters = [
		{ slug: undefined, filter: 'all', label: 'All' },
		{ slug: 'essays', filter: 'essay', label: 'Essays' },
		{ slug: 'logs', filter: 'log', label: 'Logs' },
		{ slug: 'notes', filter: 'note', label: 'Notes' },
	];

	return [
		...collectionFilters.map(({ slug, filter, label }) => ({
			params: { slug },
			props: { pageType: 'collection', filter, label },
		})),
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { pageType: 'post', post },
		})),
	];
}

const tabs = [
	{ href: '/writing', label: 'All' },
	{ href: '/writing/essays', label: 'Essays' },
	{ href: '/writing/logs', label: 'Logs' },
	{ href: '/writing/notes', label: 'Notes' },
];

const { pageType, filter, label, post } = Astro.props;
const posts = pageType === 'collection'
	? filter === 'all'
		? allPosts
		: allPosts.filter((entry) => (entry.data.postType ?? 'essay') === filter)
	: [];
const title = filter === 'all' ? 'Writing | Ray\'s Lab' : `${label} | Writing | Ray's Lab`;
---

{pageType === 'collection' ? (
	<BaseLayout
		title={title}
		description="Browse all writing from Ray's Lab ??essays, build logs, and notes from ongoing work on AI learning tools."
		activeNav="writing"
	>
		<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12">
			<div class="motion-reveal mb-6 sm:mb-8" style="--reveal-order: 0;">
				<p class="eyebrow text-xs font-medium">Ray's Lab</p>
				<h1 class="mt-2 font-display text-4xl font-semibold">Writing</h1>
			</div>

			<nav class="motion-reveal editorial-tabs mb-8" style="--reveal-order: 0;" aria-label="Content type filter">
				{tabs.map((tab) => (
					<a
						href={tab.href}
						class="editorial-tab"
						aria-current={tab.href === Astro.url.pathname ? 'page' : undefined}
					>
						{tab.label}
					</a>
				))}
			</nav>

			{posts.length > 0 ? (
				<div class="grid gap-4 sm:gap-5">
					{posts.map((entry) => (
						<div>
							<PostCard post={entry} showType={true} showProject={true} showTakeaway={true} />
						</div>
					))}
				</div>
			) : (
				<div class="motion-reveal text-center py-16" style="--reveal-order: 1;">
					<p class="text-muted">No {label.toLowerCase()} yet. Check back soon.</p>
				</div>
			)}
		</div>
	</BaseLayout>
) : (
	<WritingPostPage post={post} allPosts={allPosts} />
)}
