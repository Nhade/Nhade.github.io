---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { currentFocus } from '../data/current-focus';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featuredPost, ...remainingPosts] = allPosts;
const recentPosts = (remainingPosts.length > 0 ? remainingPosts : allPosts).slice(0, 4);

const allProjects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<BaseLayout
	title="Ray's Lab"
	description="A public build journal for AI learning tools — build logs, experiments, and essays from ongoing work on personalized learning systems."
	activeNav="home"
>
	<div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-10 sm:px-6 sm:py-12">
		<section id="home" class="grid gap-6 lg:grid-cols-[minmax(0,1.7fr)_22rem] lg:items-start">
			<div class="editorial-panel editorial-hero motion-reveal rounded-box px-6 py-7 sm:px-10 sm:py-10" style="--reveal-order: 0;">
				<div class="max-w-3xl space-y-5">
					<div class="badge badge-outline border-base-content/10 bg-base-100/30 px-3 py-3 text-[0.7rem] font-medium tracking-[0.22em] text-muted uppercase">
						Building AI learning tools
					</div>
					<div class="space-y-4">
						<p class="eyebrow text-xs font-medium">Ray's Lab</p>
						<h1 class="font-display text-4xl font-semibold leading-[1.02] tracking-tight sm:text-5xl lg:text-7xl">
							I build tools that
							<br class="hidden sm:block" />
							make learning smarter
							<br class="hidden sm:block" />
							— and write about the process.
						</h1>
						<p class="max-w-2xl text-[1.05rem] leading-8 text-base-content/76 sm:text-[1.1rem]">
							A public build journal for AI-powered learning tools like AntiCopilot and a Japanese learning app. Build logs, experiments, and essays from ongoing work.
						</p>
					</div>
					<div class="flex flex-wrap gap-3 pt-2">
						<a href="/now" class="btn btn-primary">See current work</a>
						<a href="/projects" class="btn btn-outline">See what I'm building</a>
					</div>
				</div>
			</div>

			<aside class="editorial-card editorial-sidepanel motion-reveal rounded-box p-6 sm:p-7" style="--reveal-order: 1;">
				<div class="flex items-center justify-between gap-4">
					<div>
						<p class="eyebrow text-xs font-medium">Now</p>
						<h2 class="mt-2 text-xl font-semibold">Current focus</h2>
					</div>
					<StatusBadge status={currentFocus.status} />
				</div>
				<div class="mt-6 space-y-5">
					<div>
						<p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Project</p>
						<p class="mt-2 text-sm font-semibold leading-7 text-primary">
							<a href={currentFocus.projectUrl} class="hover:underline">{currentFocus.project}</a>
						</p>
					</div>
					<div class="border-t border-base-content/8 pt-5">
						<p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Latest milestone</p>
						<p class="mt-2 text-sm leading-7 text-base-content/74">{currentFocus.latestMilestone}</p>
					</div>
					<div class="border-t border-base-content/8 pt-5">
						<p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Testing now</p>
						<p class="mt-2 text-sm leading-7 text-base-content/74">{currentFocus.testingNow}</p>
					</div>
				</div>
			</aside>
		</section>

		<section class="motion-reveal space-y-5" style="--reveal-order: 1;">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="eyebrow text-xs font-medium">Current work</p>
					<h2 class="mt-2 font-display text-3xl font-semibold">Signals from the current build</h2>
				</div>
			</div>
			<div class="grid gap-4 lg:grid-cols-3">
				<article class="editorial-card rounded-box p-6">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Current milestone</p>
					<p class="mt-3 text-sm leading-7 text-base-content/82">{currentFocus.latestMilestone}</p>
				</article>
				<article class="editorial-card rounded-box p-6">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Recent experiment</p>
					<p class="mt-3 text-sm leading-7 text-base-content/82">{currentFocus.recentExperiment}</p>
				</article>
				<article class="editorial-card rounded-box p-6">
					<p class="text-[0.68rem] font-semibold tracking-[0.18em] text-muted uppercase">Current question</p>
					<p class="mt-3 text-sm leading-7 text-base-content/82">{currentFocus.currentQuestion}</p>
				</article>
			</div>
		</section>

		{allProjects.length > 0 && (
			<section class="motion-reveal space-y-5" style="--reveal-order: 2;">
				<div class="flex items-end justify-between gap-4">
					<div>
						<p class="eyebrow text-xs font-medium">Active projects</p>
						<h2 class="mt-2 font-display text-3xl font-semibold">What I'm building</h2>
					</div>
					<a href="/projects" class="editorial-link hidden text-sm sm:inline">See all projects</a>
				</div>
				<div class="grid gap-4 md:grid-cols-2">
					{allProjects.filter(p => p.data.status === 'active').map((project) => (
						<ProjectCard project={project} variant="compact" />
					))}
				</div>
			</section>
		)}

		{featuredPost && (
			<section class="motion-reveal space-y-5" style="--reveal-order: 3;">
				<div class="flex items-end justify-between gap-4">
					<div>
						<p class="eyebrow text-xs font-medium">Featured</p>
						<h2 class="mt-2 font-display text-3xl font-semibold">Start here</h2>
					</div>
					<a href={`/blog/${featuredPost.id}`} class="editorial-link hidden text-sm sm:inline">Open featured writing</a>
				</div>

				<article class="editorial-panel editorial-feature rounded-box p-7 sm:p-9">
					<div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)] lg:items-end">
						<div class="max-w-2xl">
							<time datetime={featuredPost.data.pubDate.toISOString()} class="text-muted text-sm">
								{formatDate(featuredPost.data.pubDate)}
							</time>
							<h3 class="mt-3 font-display text-3xl font-semibold leading-tight sm:text-4xl">
								{featuredPost.data.title}
							</h3>
							<p class="mt-4 text-[1.02rem] leading-8 text-base-content/74">
								{featuredPost.data.description}
							</p>
						</div>
						<div class="rounded-box border border-base-content/8 bg-base-100/35 p-5">
							<p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Why this piece</p>
							<p class="mt-3 text-sm leading-7 text-base-content/74">
								A good entry point if you're new here — more honest than a landing page, and closer to the actual work than a portfolio write-up.
							</p>
							<div class="mt-5">
								<a href={`/blog/${featuredPost.id}`} class="btn btn-primary btn-sm">Read the piece</a>
							</div>
						</div>
					</div>
				</article>
			</section>
		)}

		<section id="posts" class="motion-reveal space-y-5" style="--reveal-order: 4;">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="eyebrow text-xs font-medium">Recent writing</p>
					<h2 class="mt-2 font-display text-3xl font-semibold">Latest from the lab</h2>
				</div>
				<a href="/writing" class="editorial-link hidden text-sm sm:inline">Browse all writing</a>
			</div>

			<div class="grid gap-4 md:grid-cols-2">
				{recentPosts.map((post) => (
					<PostCard post={post} showType={true} />
				))}
			</div>
		</section>

		<section id="about" class="editorial-panel motion-reveal rounded-box p-8 sm:p-9" style="--reveal-order: 5;">
			<div class="max-w-2xl">
				<p class="eyebrow text-xs font-medium">About</p>
				<h2 class="mt-2 font-display text-3xl font-semibold">A public build journal</h2>
				<p class="mt-4 text-[1.02rem] leading-8 text-base-content/76">
					I'm Ray, a 3rd-year CS student at NCKU building AI-powered learning tools. This site is where I document what I'm building, what I'm learning, and the design decisions along the way.
				</p>
				<div class="mt-5">
					<a href="/about" class="btn btn-outline btn-sm">Learn more</a>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
