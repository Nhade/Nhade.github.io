---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
).filter((p) => p.data.status === 'active');
---

<BaseLayout
	title="About | Ray's Lab"
	description="About Ray — 3rd-year CS student at NCKU building AI-powered learning tools and documenting the process."
	activeNav="about"
>
	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12">
		<div class="motion-reveal space-y-6" style="--reveal-order: 0;">
			<p class="eyebrow text-xs font-medium">About</p>
			<h1 class="font-display text-4xl font-semibold sm:text-5xl">Hi, I'm Ray.</h1>
		</div>

		<div class="motion-reveal mt-8 space-y-6 text-[1.02rem] leading-8 text-base-content/82" style="--reveal-order: 1;">
			<p>
				I'm a 3rd-year Computer Science student at National Cheng Kung University (NCKU). I started building AI learning tools by accident — experimenting with side project ideas, I tried combining AI with something I actually cared about: learning Japanese. That experiment stuck, and the work since has felt purposeful in a way that's hard to manufacture. Being a learner myself means I can judge my own tools critically and solve the pain points I actually hit.
			</p>
			<p>
				This site is my public build journal. It's where I document what I'm building, share what I'm learning, and think through the design decisions along the way. You'll find polished essays alongside rough build logs and quick notes — all part of building in the open.
			</p>
		</div>

		{allProjects.length > 0 && (
			<section class="motion-reveal mt-12" style="--reveal-order: 2;">
				<h2 class="eyebrow text-xs font-medium">Current projects</h2>
				<div class="mt-4 space-y-4">
					{allProjects.map((project) => (
						<a href={`/projects#${project.data.slug}`} class="editorial-card block rounded-box p-5 transition-colors">
							<div class="flex items-center justify-between gap-4">
								<h3 class="text-lg font-semibold">{project.data.title}</h3>
								<span class="text-xs text-muted">{project.data.status}</span>
							</div>
							<p class="mt-2 text-sm leading-7 text-base-content/72">{project.data.description}</p>
						</a>
					))}
				</div>
			</section>
		)}

		<section class="motion-reveal mt-12 editorial-panel rounded-box p-6 sm:p-8" style="--reveal-order: 3;">
			<h2 class="text-lg font-semibold">Get in touch</h2>
			<p class="mt-3 text-sm leading-7 text-base-content/72">
				Find me on <a href="https://github.com/Nhade" target="_blank" rel="noopener noreferrer" class="editorial-link">GitHub</a>,
				connect on <a href="https://www.linkedin.com/in/jui-chien-chen-37718b3b3/" target="_blank" rel="noopener noreferrer" class="editorial-link">LinkedIn</a>,
				or email me at <a href="mailto:f74122129@gs.ncku.edu.tw" class="editorial-link">f74122129@gs.ncku.edu.tw</a>.
			</p>
		</section>
	</div>
</BaseLayout>
